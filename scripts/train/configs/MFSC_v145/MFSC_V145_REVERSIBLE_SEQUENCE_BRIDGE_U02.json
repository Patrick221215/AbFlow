  "confidence": {
    "enabled": true,
    "pae_enabled": true,
    "generator_detached": true,
    "coordinate_semantics": "decoded_clean_endpoint"
  },
  "loss_weights": {
    "transport": 1.0,
    "sequence": 0.4,
    "aligned_mse": 0.5,
    "smooth_lddt": 0.1,
    "distogram": 0.5,
    "confidence": 0.025,
    "notes": {
      "transport": "U02 remains the unique primary trajectory authority.",
      "sequence": "Clean-endpoint sequence CE on the V145 reversible Uniform(20) categorical path; coefficient 0.4 unchanged.",
      "aligned_mse": "V140: existing 0.5 MFDesign-style rigid-aligned MSE is applied to the exact emitted antibody endpoint: global framework plus decoded U02 H3. No new coefficient.",
      "smooth_lddt": "V140: existing 0.1 MFDesign smooth-lDDT is applied to all resolved atoms of the exact emitted antibody endpoint in raw Angstrom coordinates; 0.5/1/2/4 A thresholds and 15 A native cutoff are unchanged.",
      "distogram": "Only this pair auxiliary keeps the C1 near-native gate because persistent z observes X_t rather than decoded X1.",
      "confidence": "Generator-detached; decoded X1 is converted from raw Å to AtomStructure model units before confidence calibration."
    },
    "confidence_components": {
      "plddt": 1.0,
      "pde": 1.0,
      "pae": 1.0,
      "resolved": 1.0,
      "aggregation": "sum_then_global_weight",
      "rationale": "MFDesign equal internal confidence components; global 0.025 normalizes four components to an ABX-like ~0.1 confidence-family scale when raw CE magnitudes are comparable."
    },
    "geometry_coordinate_scaling": 0.1,
    "distogram_gate_start": 0.75
  },
  "optimizer_profile": {
    "optimizer": "adam",
    "beta1": 0.9,
    "beta2": 0.95,
    "eps": 1e-08,
    "scheduler": "abx_taskscale_af3",
    "base_lr": 0.0,
    "max_lr": 0.0003,
    "warmup_ratio": 0.05,
    "decay_start_ratio": 0.5,
    "decay_every_ratio": 0.1,
    "decay_factor": 0.95,
    "gradient_clip": 1.0,
    "ema_decay": 0.999
  },
  "objective": {
    "mode": "mfdesign_abx_physical_endpoint",
    "global_coordinate_scope": "cmask_full_antibody",
    "physical_geometry_scope": "emitted_full_antibody_composite",
    "posthoc_h3_kabsch": true,
    "coordinate_refinement": "u02_sampler_state_evolution",
    "h3_terminal": "integrated_u02_endpoint",
    "sequence_terminal": "integrated_reversible_categorical_state",
    "latent_recycling_role": "mfdesign_native_final_recycle_gradient",
    "representation_refinement": "mfdesign_internal_recycling_3",
    "proposal_frame_mode": "pcs_h3_kabsch",
    "common_center_source": "proposal_aligned_template",
    "frame_anchor": "PCS_RC_H3_backbone_only",
    "native_antibody_used_for_frame": false,
    "frame_order": [
      "align generic antibody template H3 to PCS-RC H3",
      "apply same rigid transform to full H/L template",
      "compute common center from proposal-aligned antibody template CA",
      "center antigen/template/X_pep/Xt with same center",
      "scale coordinates by 0.1"
    ],
    "sequence_latent_authority": "mfdesign_structure_2x_token",
    "sequence_latent_width": 512,
    "sequence_latent_source": "post_atom_encoder_pair_conditioned_token_diffusion_transformer",
    "sequence_structure_shared_latent": true,
    "legacy_sequence_hidden_numerical_authority": false,
    "sequence_process": "uniform_reversible",
    "sequence_path": "q_t=t_delta_clean_plus_(1-t)_uniform20",
    "sequence_clean_target": "S1_clean_endpoint",
    "sequence_reverse_kernel": "exact_x0_marginalized_uniform_bridge",
    "sequence_tokens_correctable": true,
    "posthoc_sequence_argmax": false
  },
  "diagnostics": {
    "first_n_train_steps": 8,
    "print_startup_contract": true,
    "print_forward_ms": true,
    "print_cuda_peak": true,
    "print_runtime_counters": true,
    "print_weighted_losses": true,
    "note": "V145 single scientific change relative to V144: replace irreversible MASK-absorbing sequence dynamics with the reversible Uniform(20) path q_t=t*delta_clean+(1-t)*Uniform20. The network remains a clean-endpoint predictor with CE weight 0.4. Sampling uses the exact finite-step reverse bridge analytically marginalized over p_theta(S1|S_t,t), so early wrong tokens can be corrected. The formal t=1 sequence is the integrated ancestral state and no post-hoc argmax overwrites it. V144 raw MF a512 sequence authority, V143 PCS frame, MF backbone, U02, structure losses, SC, confidence, optimizer, EMA and batch are frozen."
  },
