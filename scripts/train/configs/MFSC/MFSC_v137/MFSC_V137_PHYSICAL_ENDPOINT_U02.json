{
  "train_set": "./datasets/RAbD/train.json",
  "valid_set": "./datasets/RAbD/valid.json",
  "save_dir": "./results_module/MFSC_V137_PHYSICAL_ENDPOINT_U02",
  "train_pep": "./datasets/RAbD/train.pkl",
  "valid_pep": "./datasets/RAbD/valid.pkl",
  "train_surf": "./datasets/RAbD/train_surf.pkl",
  "valid_surf": "./datasets/RAbD/valid_surf.pkl",
  "cdr": "H3",
  "paratope": "H3",
  "max_epoch": 200,
  "save_topk": 10,
  "batch_size": 8,
  "shuffle": true,
  "model_type": "AbFlow",
  "embed_dim": 256,
  "hidden_size": 256,
  "num_verts": 50,
  "k_neighbors": 9,
  "n_layers": 4,
  "iter_round": 1,
  "pep_seq": true,
  "pep_struct": true,
  "bind_dist_cutoff": 6.6,
  "no_pred_edge_dist": true,
  "no_memory": true,
  "lr": 0.0003,
  "final_lr": 3e-05,
  "warmup": 0,
  "grad_clip": 1.0,
  "patience": 1000,
  "save_interval": 1,
  "use_ema": true,
  "ema_decay": 0.999,
  "num_workers": 8,
  "prefetch_factor": 4,
  "valid_num_workers": 2,
  "valid_prefetch_factor": 2,
  "amp": true,
  "amp_dtype": "bf16",
  "allow_tf32": true,
  "log_interval": 10,
  "tqdm_mininterval": 10.0,
  "self_conditioning": {
    "enabled": true,
    "probability": 0.5,
    "mode": "detached_clean_endpoint_ca_distogram",
    "lazy_teacher_forward": true,
    "expected_structure_queries_per_training_graph": 1.5
  },
  "confidence": {
    "enabled": true,
    "pae_enabled": true,
    "generator_detached": true,
    "coordinate_semantics": "decoded_clean_endpoint"
  },
  "loss_weights": {
    "transport": 1.0,
    "sequence": 0.4,
    "aligned_mse": 0.5,
    "smooth_lddt": 0.1,
    "distogram": 0.5,
    "confidence": 0.025,
    "notes": {
      "transport": "U02 remains the unique primary trajectory authority.",
      "sequence": "Masked-absorbing sequence CE; unchanged from V136.",
      "aligned_mse": "Full-time decoded physical X1; Kabsch target; Cartesian error scaled by 0.1 before MSE so Å^2 does not dominate.",
      "smooth_lddt": "Full-time decoded physical X1; raw Å distances; MFDesign 0.5/1/2/4 Å smooth thresholds; no t-gate.",
      "distogram": "Only this pair auxiliary keeps the C1 near-native gate because persistent z observes X_t rather than decoded X1.",
      "confidence": "Generator-detached; decoded X1 is converted from raw Å to AtomStructure model units before confidence calibration."
    },
    "confidence_components": {
      "plddt": 1.0,
      "pde": 1.0,
      "pae": 1.0,
      "resolved": 1.0,
      "aggregation": "sum_then_global_weight",
      "rationale": "MFDesign equal internal confidence components; global 0.025 normalizes four components to an ABX-like ~0.1 confidence-family scale when raw CE magnitudes are comparable."
    },
    "geometry_coordinate_scaling": 0.1,
    "distogram_gate_start": 0.75
  },
  "optimizer_profile": {
    "optimizer": "adam",
    "beta1": 0.9,
    "beta2": 0.95,
    "eps": 1e-08,
    "scheduler": "abx_taskscale_af3",
    "base_lr": 0.0,
    "max_lr": 0.0003,
    "warmup_ratio": 0.05,
    "decay_start_ratio": 0.5,
    "decay_every_ratio": 0.1,
    "decay_factor": 0.95,
    "gradient_clip": 1.0,
    "ema_decay": 0.999
  },
  "objective": {
    "mode": "mfdesign_abx_physical_endpoint"
  },
  "diagnostics": {
    "first_n_train_steps": 8,
    "print_startup_contract": true,
    "print_forward_ms": true,
    "print_cuda_peak": true,
    "print_runtime_counters": true,
    "print_weighted_losses": true,
    "note": "V137 Physical Endpoint Consistency: validation geometry is decoded X1; aligned MSE and smooth-lDDT are full-time physical-endpoint losses; final H3 readout is literally integrated Xt(t=1); rollout/readout/loss-authority diagnostics are printed without changing sampler state."
  },
  "runtime_env": {
    "ABFLOW_SOURCE_MODE": "pcs_rc",
    "ABFLOW_RECURRENT_PROPOSAL_CONTEXT": "on",
    "ABFLOW_COORD_PEP_SOURCE_WEIGHT": "1.0",
    "ABFLOW_SEQ_PEP_SOURCE_WEIGHT": "1.0",
    "ABFLOW_COORD_PEP_AS_CONDITION": "off",
