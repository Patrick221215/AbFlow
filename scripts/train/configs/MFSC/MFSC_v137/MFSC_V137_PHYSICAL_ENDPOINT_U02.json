  "architecture": {
    "token_s": 256,
    "token_z": 128,
    "atom_s": 128,
    "atom_z": 16,
    "pairformer_blocks": 4,
    "pairformer_heads": 16,
    "pairformer_dropout": 0.1,
    "pairwise_heads": 4,
    "pairwise_head_width": 32,
    "atom_window_queries": 32,
    "atom_window_keys": 128,
    "atom_encoder_depth": 3,
    "atom_encoder_heads": 4,
    "token_transformer_depth": 8,
    "token_transformer_heads": 16,
    "atom_decoder_depth": 3,
    "sequence_hidden": 256,
