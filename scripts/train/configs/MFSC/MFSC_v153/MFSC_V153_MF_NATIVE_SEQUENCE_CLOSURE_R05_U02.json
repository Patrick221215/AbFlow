  "diagnostics": {
    "first_n_train_steps": 8,
    "print_startup_contract": true,
    "print_forward_ms": true,
    "print_cuda_peak": true,
    "print_runtime_counters": true,
    "print_weighted_losses": true,
    "note": "V153 formal executable contract: iter_round=1; fixed Score-Flow Xt inside MF stateful K~Uniform{1,2,3}; MF s/z + decoded clean X1 + soft sequence posterior recycled with stop-gradient; only final sampled depth carries gradient. Sequence-only change: inference-available PCS-RC S_pep and detached soft clean posterior enter the true MF single initialization directly after s_init. Historical V150 outer_rounds=3 wording is invalid.",
    "epoch_test_memory_fix": {
      "science_change": false,
      "every_epoch_test": true,
      "n_steps_unchanged": 10,
      "formal_logical_batch_size": 20,
      "root_cause": "torch.set_grad_enabled(True) inside V150 outer recycling overrode sample() @torch.no_grad() during evaluation.",
      "evidence": "With logical batch=5, all ranks started Test at ~1.1 GiB allocated, then the first rollout step still climbed to ~45.44-45.56 GiB and OOMed.",
      "fix": "Preserve caller grad mode in the outer loop and wrap distributed Test generation in torch.inference_mode().",
      "why_batch20_restored": "Preserves historical logical_batch_seeded_v1 RNG grouping and Test comparability."
    },
    "v152_design_note": "V152 is a model-level reset, not a V151 patch.  Score-Flow Xt is fixed through all recycles.  MF single/pair state, analytically decoded clean X1 and soft sequence posterior are recycled with stop-gradient.  Training samples terminal recycle depth K in {1,2,3}; only K is gradient-bearing. Inference uses K=3.  This restores MF-style memory semantics without V151 full recurrent BPTT, while retaining the strongest R05 U02 path.",
    "v153_design_note": "V153 is a single-factor model-level sequence closure on the validated V152 structure parent. PCS-RC S_pep and the detached previous soft clean-sequence posterior no longer fuse through legacy AbFlow H_0. They are mapped by zero-start adapters and added directly after AMEncoder.s_init to the MF single stream. R05/U02, fixed-Xt MF stateful recycling, coordinate path, all loss weights, optimizer, EMA, batch, confidence and Test protocol are frozen."
  },
