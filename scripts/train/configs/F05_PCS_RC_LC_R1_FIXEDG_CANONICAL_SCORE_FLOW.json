{
  "train_set": "./datasets/RAbD/train.json",
  "valid_set": "./datasets/RAbD/valid.json",
  "save_dir": "./datasets/RAbD/models_single_cdr_design",
  "train_pep": "./datasets/RAbD/train.pkl",
  "valid_pep": "./datasets/RAbD/valid.pkl",
  "train_surf": "./datasets/RAbD/train_surf.pkl",
  "valid_surf": "./datasets/RAbD/valid_surf.pkl",
  "cdr": "H3",
  "max_epoch": 200,
  "save_topk": 10,
  "batch_size": 56,
  "shuffle": true,
  "model_type": "AbFlow",
  "embed_dim": 64,
  "hidden_size": 128,
  "num_verts": 50,
  "k_neighbors": 9,
  "n_layers": 3,
  "iter_round": 3,
  "pep_seq": true,
  "pep_struct": true,
  "bind_dist_cutoff": 6.6,
  "save_interval": 1,
  "resume_checkpoint": "",
  "use_ema": true,
  "ema_decay": 0.999,
  "num_workers": 8,
  "prefetch_factor": 4,
  "valid_num_workers": 4,
  "valid_prefetch_factor": 2,
  "amp": true,
  "amp_dtype": "bf16",
  "allow_tf32": true,
  "log_interval": 1,
  "tqdm_mininterval": 5.0,
  "_experiment": {
    "exp_id": "F05_PCS_RC_LC_R1_FIXEDG_CANONICAL_SCORE_FLOW",
    "parent": "F04_PCS_RC_LC_R1_CLEAN_MEAN_FLOW",
    "loss_mode": "fixedg_r3_canonical_score_flow",
    "sampler_mode": "sf2m_ode",
    "single_change": "replace the deterministic path by an exactly sampleable fixed source-noise Gaussian path and learn its complete canonical probability velocity in one carrier",
    "physical_object": "u_theta approximates (X1-X0)-sigma_dot*q_star with sigma=g(1-t), sigma_dot=-g, q_star=sigma*score",
    "fixed_g_angstrom": 0.5,
    "endpoint_coordinate_train_weight": 0.0,
    "terminal_projection": false,
    "score_objective": "implicit_in_canonical_probability_velocity",
    "pair_time_scope": "off"
  }
}
