{
  "experiment": {
    "id": "R05_PCS_RC_LC_R1_ABX_FF_FIXEDG_FULLATOM_U02_SCOREFLOW",
    "parent": "R05_PCS_RC_LC_R1_ABX_FF_FIXEDG_RESIDUE_U02_SCOREFLOW",
    "initialization": "scratch",
    "factor": "Matched R05 support ablation: residue-shared R3 Gaussian -> independent Cartesian Gaussian on every currently model-visible atom. All original R05 architecture, PCS-RC source/context, U02 carrier, sampler and sequence semantics remain unchanged.",
    "protocol": "formal_train_val_test",
    "diagnostic_role": "r05_fullatom_noise_support_only",
    "causal_question": "Does expanding original R05 stochastic support from 3 DoF per residue to independent atom-wise Cartesian noise improve generation without changing the R05 model?"
  },
  "data": {
    "train": {
      "set": "./datasets/RAbD/train.json",
      "pep": "./datasets/RAbD/train.pkl",
      "surface": "./datasets/RAbD/train_surf.pkl"
    },
    "valid": {
      "set": "./datasets/RAbD/valid.json",
      "pep": "./datasets/RAbD/valid.pkl",
      "surface": "./datasets/RAbD/valid_surf.pkl"
    },
    "test": {
      "set": "./datasets/RAbD/test.json",
      "pep": "./datasets/RAbD/test.pkl",
      "surface": "./datasets/RAbD/test_surf.pkl"
    },
    "task": {
      "cdr": [
        "H3"
      ],
      "paratope": [
        "H3"
      ],
      "num_verts": 50
    }
  },
  "training": {
    "output_dir": "./results_module/R05_PCS_RC_LC_R1_ABX_FF_FIXEDG_FULLATOM_U02_SCOREFLOW",
    "optimizer": {
      "lr": 0.001,
      "final_lr": 0.0001,
      "warmup": 0,
      "grad_clip": 1.0
    },
    "schedule": {
      "max_epoch": 200,
      "patience": 1000,
      "save_topk": 10,
      "save_interval": 1,
      "resume_checkpoint": ""
    },
    "loader": {
      "per_gpu_batch_size": 5,
      "shuffle": true,
      "num_workers": 8,
      "prefetch_factor": 4,
      "valid_num_workers": 2,
      "valid_prefetch_factor": 2,
      "valid_persistent_workers": false
    },
    "precision": {
      "amp": true,
      "amp_dtype": "bf16",
      "allow_tf32": true
    },
    "ema": {
      "enabled": true,
      "decay": 0.999
    },
    "logging": {
      "log_interval": 1,
      "tqdm_mininterval": 5.0,
      "science_first_steps": 3,
      "science_interval": 0,
      "runtime_guard_steps": 2,
      "train_loss_outlier_threshold": 10000.0
    },
    "snapshot": {
      "enabled": true,
      "max_mb": 20.0
    }
  },
  "model": {
    "type": "AbFlow",
    "architecture": {
      "embed_dim": 64,
      "hidden_size": 128,
      "k_neighbors": 9,
      "n_layers": 3,
      "iter_round": 3,
      "dropout": 0.1,
      "relative_position": false
    },
    "task": {
      "pep_seq": true,
      "pep_struct": true,
      "struct_only": false,
      "bind_dist_cutoff": 6.6,
      "pred_edge_dist": true,
      "backbone_only": false,
      "fix_channel_weights": false,
      "keep_memory": true,
      "seq_warmup": 0
    },
    "r05": {
      "source": {
        "proposal_adapter_start_round": 1
      },
      "flow": {
        "min_sigma": 0.01,
        "hybrid_t_min": 0.2
      },
      "r3": {
        "transport_fraction": 0.05,
        "path_min_sigma": 0.0,
        "coordinate_scaling": 0.1,
        "fixed_g_scaled": 0.1,
        "g_mode": "foldflow_fixed_scaled",
        "noise_scope": "full_atom"
      }
    }
  },
  "loss": {
    "sequence": 1.0,
    "structure": 1.0,
    "interface": 1.0,
    "edge": 1.0,
    "distogram": {
      "weight": 0.0,
      "pair_scope": "all_resolved",
      "bins": 64,
      "min_bin": 2.3125,
      "max_bin": 21.6875
    },
    "smooth_lddt": {
      "weight": 0.0,
      "cutoff": 15.0,
      "prediction_source": "pred_design_endpoint"
    }
  },
  "runtime": {
    "ddp": {
      "cost_balanced": true,
      "find_unused_parameters": false,
      "static_graph": true
    }
  },
  "generation": {
    "checkpoint": "",
    "save_dir": "./results_generation/R05_PCS_RC_LC_R1_ABX_FF_FIXEDG_FULLATOM_U02_SCOREFLOW",
    "batch_size": 20,
    "num_workers": 4,
    "n_steps": 10,
    "seed": 2023,
    "show_sample_progress": false,
    "terminal_coordinate_authority": "integrated_endpoint",
    "fixed_context": "unchanged_exactly",
    "terminal_kabsch_fusion": false
  },
  "evaluation": {
    "metric_workers": 8,
    "keep_structures": false,
    "failure_policy": "record_and_continue",
    "root_cause_diagnostics": {
      "test_exact_trajectory_compact": true,
      "kabsch_metric_only_no_coordinate_mutation": true
    }
  }
}
