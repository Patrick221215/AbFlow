{
  "train_set": "./datasets/RAbD/train.json",
  "valid_set": "./datasets/RAbD/valid.json",
  "save_dir": "./results_module/MFSC_V124_EXACT_SPEED_CANDIDATE_BS8",
  "train_pep": "./datasets/RAbD/train.pkl",
  "valid_pep": "./datasets/RAbD/valid.pkl",
  "train_surf": "./datasets/RAbD/train_surf.pkl",
  "valid_surf": "./datasets/RAbD/valid_surf.pkl",
  "cdr": "H3",
  "paratope": "H3",
  "max_epoch": 1,
  "save_topk": 1,
  "batch_size": 8,
  "shuffle": true,
  "model_type": "AbFlow",
  "embed_dim": 64,
  "hidden_size": 128,
  "num_verts": 50,
  "k_neighbors": 9,
  "n_layers": 3,
  "iter_round": 1,
  "pep_seq": true,
  "pep_struct": true,
  "bind_dist_cutoff": 6.6,
  "no_pred_edge_dist": true,
  "no_memory": true,
  "lr": 0.001,
  "final_lr": 0.0001,
  "warmup": 5,
  "grad_clip": 1.0,
  "patience": 1000,
  "save_interval": 1,
  "resume_checkpoint": "",
  "use_ema": true,
  "ema_decay": 0.999,
  "num_workers": 8,
  "prefetch_factor": 4,
  "valid_num_workers": 2,
  "valid_prefetch_factor": 2,
  "amp": true,
  "amp_dtype": "bf16",
  "allow_tf32": true,
  "log_interval": 10,
  "tqdm_mininterval": 10.0,
  "_experiment": {
    "exp_id": "MFSC_V124_EXACT_SPEED_CANDIDATE_BS8",
    "parent": "MFSC_V123_SPEED_PROFILE_BS8",
    "scientific_change": "none",
    "runtime_only_changes": [
      "remove per-complex torch.clear_autocast_cache",
      "flowtest Pairformer activation checkpoint off",
      "auto full-attention threshold 448 MiB (observed train max full logits ~412 MiB)"
    ],
    "acceptance": {
      "no_oom": true,
      "peak_memory_target_gib": "<= 40",
      "end_alloc_target_mib": "< 500",
      "attn_lma_target": 0,
      "checkpoint_cleanup_target": 0,
      "speed_target": "materially below v123 ~2.52 s/step after warmup"
    }
  }
}
